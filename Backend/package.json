{
    "name": "backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "start": "node app.js",
        "dev": "nodemon app.js",
        "test": "jest --coverage --verbose",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci --coverage --maxWorkers=2",
        "db:size": "node scripts/checkDbSize.js",
        "db:cleanup": "node scripts/cleanupDatabase.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "joi": "^18.0.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.19.2",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "razorpay": "^2.9.6",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "supertest": "^7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.js",
            "**/?(*.)+(spec|test).js"
        ]
    },
    "description": ""
}
