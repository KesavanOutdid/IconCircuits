  "pricing_rules": [
    {
      "ruleName": "Base Component Sourcing Fee",
      "conditions": {
        "component_count": "<=50"
      },
      "basePrice": 500,
      "calculationType": "fixed",
      "formula": null,
      "status": true
    },
    {
      "ruleName": "Component Sourcing Fee - Medium BOM",
      "conditions": {
        "component_count": "51-150"
      },
      "basePrice": 800,
      "calculationType": "fixed",
      "formula": null,
      "status": true
    },
    {
      "ruleName": "Component Sourcing Fee - Large BOM",
      "conditions": {
        "component_count": "151+"
      },
      "basePrice": 1200,
      "calculationType": "fixed",
      "formula": null,
      "status": true
    },
    {
      "ruleName": "Component Cost Markup - Standard",
      "conditions": {
        "sourcing_type": "standard"
      },
      "basePrice": 0,
      "calculationType": "percentage",
      "formula": "component_cost * 1.10",
      "status": true
    },
    {
      "ruleName": "Component Cost Markup - Custom",
      "conditions": {
        "sourcing_type": "custom"
      },
      "basePrice": 0,
      "calculationType": "percentage",
      "formula": "component_cost * 1.20",
      "status": true
    },
    {
      "ruleName": "Hard-to-Find Component Fee",
      "conditions": {
        "sourcing_type": "custom",
        "availability": "hard_to_find"
      },
      "basePrice": 300,
      "calculationType": "fixed",
      "formula": null,
      "status": true
    },
    {
      "ruleName": "Advanced Verification Fee",
      "conditions": {
        "verification": "advanced"
      },
      "basePrice": 400,
      "calculationType": "fixed",
      "formula": null,
      "status": true
    },
    {
      "ruleName": "Express Sourcing Premium",
      "conditions": {
        "lead_time": "<=7"
      },
      "basePrice": 0,
      "calculationType": "percentage",
      "formula": "total_cost * 1.25",
      "status": true
    }
  ],
