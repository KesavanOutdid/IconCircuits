  "pricing_rules": [
    {
      "ruleName": "Base PCB Fabrication - 2 Layer",
      "conditions": {
        "layer": "2",
        "board_area_sqm": "<=0.01",
        "quantity": "<=10"
      },
      "basePrice": 500,
      "calculationType": "formula",
      "formula": "basePrice + (board_area_sqm * 5000) + (quantity * 50)",
      "status": true
    },
    {
      "ruleName": "Base PCB Fabrication - 4 Layer",
      "conditions": {
        "layer": "4",
        "board_area_sqm": "<=0.01",
        "quantity": "<=10"
      },
      "basePrice": 900,
      "calculationType": "formula",
      "formula": "basePrice + (board_area_sqm * 9000) + (quantity * 90)",
      "status": true
    },
    {
      "ruleName": "PCB Assembly - SMD Components",
      "conditions": {
        "assembly": "yes",
        "smd_components": ">0"
      },
      "basePrice": 300,
      "calculationType": "formula",
      "formula": "basePrice + (smd_components * 0.5 * quantity)",
      "status": true
    },
    {
      "ruleName": "PCB Assembly - Through Hole Components",
      "conditions": {
        "assembly": "yes",
        "through_hole_components": ">0"
      },
      "basePrice": 200,
      "calculationType": "formula",
      "formula": "basePrice + (through_hole_components * 1.5 * quantity)",
      "status": true
    },
    {
      "ruleName": "PCB Assembly - BGA/QFN Components",
      "conditions": {
        "assembly": "yes",
        "bga_qfn_components": ">0"
      },
      "basePrice": 400,
      "calculationType": "formula",
      "formula": "basePrice + (bga_qfn_components * 3 * quantity)",
      "status": true
    },
    {
      "ruleName": "Component Sourcing - Turnkey",
      "conditions": {
        "component_sourcing": "turnkey"
      },
      "basePrice": 500,
      "calculationType": "percentage",
      "formula": "component_cost * 1.15",
      "status": true
    },
    {
      "ruleName": "Setup Charges - One Time",
      "conditions": {
        "first_order": true
      },
      "basePrice": 500,
      "calculationType": "fixed",
      "formula": null,
      "status": true
    },
    {
      "ruleName": "Panelization Service",
      "conditions": {
        "panel_by": "pcb_power"
      },
      "basePrice": 200,
      "calculationType": "fixed",
      "formula": null,
      "status": true
    }
  ],
